# GitHub token — used for GitHub Models LLM scoring (gpt-4o-mini, free tier)
# Run: gh auth login
# Or set manually:
GITHUB_TOKEN=your_github_token_here

# Apollo.io API key — used by apollo_enrich.py to reveal work e-mails.
# Optional: without it, apollo_enrich.py still runs and still reports any
# e-mails the employer published in the job posting itself (those are free).
# Settings → Integrations → API in Apollo.
APOLLO_API_KEY=

# LinkedIn source tuning (all optional — defaults are deliberately conservative).
# LINKEDIN_TERMS="Founder's Office,Chief of Staff,Strategy and Operations"
# LINKEDIN_LOCATIONS="India,Bangalore, India,Mumbai, India"
# LINKEDIN_RESULTS=25        # results per term x location query
# LINKEDIN_HOURS_OLD=168     # only postings newer than this
# LINKEDIN_DELAY=4           # seconds between queries; raise if you get blocked
